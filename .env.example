# Build-time environment variables for the Vite SPA.
# Copy to `.env.local` (gitignored) and edit. Anything starting with VITE_
# is bundled into the client at build time.

# Master switch for the LingBot 3D reconstruction pipeline.
#   "true"  → ScanSubmission dispatches to the `reconstruct-scan` Edge
#             Function, which triggers a RunPod job and (eventually) writes
#             `scans.pointcloud_url`. Scan rows start at processing_status="queued".
#   any other value (including unset) → LingBot dispatch is skipped entirely.
#             RunPod is never hit. Scan rows are inserted with
#             processing_status=null so the UI uses the legacy-scan branch
#             instead of showing "BUILDING…" forever.
#
# Default for safety: off. Flip to "true" in your hosting platform's build
# environment and redeploy to re-enable LingBot.
VITE_ENABLE_LINGBOT=false
